<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.ContractMapper">
    
    <resultMap type="Contract" id="ContractResult">
        <id     property="id"           column="contract_id"       />
        <result property="contractCode"    column="contract_code"    />
        <result property="customerName"    column="customer_name"    />
        <result property="productName"    column="product_name"    />
        <result property="amount"    column="amount"    />
        <result property="signDate"    column="sign_date"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="owner"    column="owner"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectContractVo">
        select contract_id,contract_code, customer_name, product_name, amount, sign_date, start_date, end_date, owner, status, create_by, create_time, update_by, update_time, remark from biz_contract
    </sql>

    <select id="selectContractList" parameterType="Contract" resultMap="ContractResult">
        <include refid="selectContractVo"/>
        <where>  
            <if test="contractCode != null  and contractCode != ''">
                and contract_code like concat('%', #{contractCode}, '%')
            </if>
            <if test="customerName != null  and customerName != ''">
                and customer_name like concat('%', #{customerName}, '%')
            </if>
            <if test="owner != null  and owner != ''">
                and owner like concat('%', #{owner}, '%')
            </if>
            <if test="status != null  and status != ''">
                and status = #{status}
            </if>
            <if test="remark != null  and remark != ''">
                and remark like concat('%', #{remark}, '%')
            </if>
        </where>
        order by contract_id desc
    </select>
    
    <select id="selectContractById" parameterType="Long" resultMap="ContractResult">
        <include refid="selectContractVo"/>
        where contract_id = #{id}
    </select>
        
    <insert id="insertContract" parameterType="Contract" useGeneratedKeys="true" keyProperty="id">
        insert into biz_contract(
            <if test="contractCode != null and contractCode != ''">contract_code,</if>
            <if test="customerName != null and customerName != ''">customer_name,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="amount != null and amount != ''">amount,</if>
            <if test="signDate != null and signDate != ''">sign_date,</if>
            <if test="startDate != null and startDate != ''">start_date,</if>
            <if test="endDate != null and endDate != ''">end_date,</if>
            <if test="owner != null and owner != ''">owner,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="contractCode != null and contractCode != ''">#{contractCode},</if>
            <if test="customerName != null and customerName != ''">#{customerName},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="amount != null and amount != ''">#{amount},</if>
            <if test="signDate != null and signDate != ''">#{signDate},</if>
            <if test="startDate != null and startDate != ''">#{startDate},</if>
            <if test="endDate != null and endDate != ''">#{endDate},</if>
            <if test="owner != null and owner != ''">#{owner},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>
        
    <update id="updateContract" parameterType="Contract">
        update biz_contract
        <set>
            <if test="contractCode != null and contractCode != ''">contract_code = #{contractCode},</if>
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="amount != null and amount != ''">amount = #{amount},</if>
            <if test="signDate != null and signDate != ''">sign_date = #{signDate},</if>
            <if test="startDate != null and startDate != ''">start_date = #{startDate},</if>
            <if test="endDate != null and endDate != ''">end_date = #{endDate},</if>
            <if test="owner != null and owner != ''">owner = #{owner},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where contract_id = #{id}
    </update>

    <delete id="deleteContractByIds" parameterType="String">
        delete from biz_contract where contract_id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
