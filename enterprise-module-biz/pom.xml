        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Excel 导出 -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
