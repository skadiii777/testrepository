<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.enterprise</groupId>
        <artifactId>enterprise-platform</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>enterprise-module-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        AI 模块：RAG 知识库 + 业务智能体
        嵌入/生成用 Ollama 本地模型；向量库用 Spring AI SimpleVectorStore（JSON 文件持久化，学习阶段零外部依赖）
        后期可无缝换 Chroma/pgvector/Milvus——只需换 VectorStore 实现
    </description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>enterprise-spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Spring AI：Ollama（聊天+嵌入），SimpleVectorStore 内置在 core 里 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
    </dependencies>
</project>
